# MedHub environment variables. Copy to .env.local for development; on cPanel, enter them in
# "Setup Node.js App" (never commit real values). Generate secrets with: pnpm keys:generate

NODE_ENV=development
MEDHUB_BASE_URL=http://localhost:3000

# PostgreSQL. The role must NOT be a superuser (superusers bypass Row Level Security).
DATABASE_URL=postgres://medhub_app:CHANGE_ME@localhost:5432/medhub_dev
TEST_DATABASE_URL=postgres://medhub_app:CHANGE_ME@localhost:5432/medhub_test
DATABASE_POOL_MAX=10

# Secrets (pnpm keys:generate prints fresh values)
MEDHUB_SESSION_SECRET=
MEDHUB_FIELD_MASTER_KEY=
MEDHUB_FILE_MASTER_KEY=
MEDHUB_BACKUP_ENCRYPTION_KEY=
MEDHUB_SIGNING_KID=
MEDHUB_SIGNING_PRIVATE_KEY=
MEDHUB_SIGNING_PUBLIC_KEY=

# Sessions
MEDHUB_SESSION_IDLE_HOURS=12
MEDHUB_SESSION_ABSOLUTE_DAYS=7

# Files (outside public_html in production)
MEDHUB_STORAGE_DIR=./storage

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Adapters. TODO(medhub-decision): SMS and payment providers are not chosen yet.
MEDHUB_SMS_PROVIDER=console
MEDHUB_PAYMENT_PROVIDER=manual
MEDHUB_TELEMETRY_ADAPTER=internal

# Logs
MEDHUB_LOG_DIR=./logs
LOG_LEVEL=info

# External backup destination (S3 compatible or SFTP), used by scripts/backup.sh
MEDHUB_BACKUP_REMOTE_URL=

# Development only: password of the fictitious demo accounts created by pnpm db:seed
MEDHUB_SEED_PASSWORD=
