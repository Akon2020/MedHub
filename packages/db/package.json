{
  "name": "@medhub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seeds/platform/plans.json": "./seeds/platform/plans.json",
    "./password": "./src/password.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests test/unit",
    "test:isolation": "vitest run test/isolation",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@medhub/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@medhub/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
