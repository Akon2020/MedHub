{
  "name": "medhub",
  "version": "0.1.0",
  "private": true,
  "description": "MedHub : système d'information de santé local-first, multi-structures",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node infra/scripts/dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && prettier --check \"**/*.{ts,tsx,mjs,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,css}\"",
    "test": "turbo run test",
    "test:props": "pnpm --filter @medhub/sync test:props",
    "test:e2e": "pnpm --filter @medhub/web test:e2e",
    "db:generate": "pnpm --filter @medhub/db db:generate",
    "db:migrate": "pnpm --filter @medhub/db db:migrate",
    "db:seed": "pnpm --filter @medhub/db db:seed",
    "db:import-areas": "pnpm --filter @medhub/db db:import-areas",
    "db:test-isolation": "pnpm --filter @medhub/db test:isolation",
    "worker:tick": "pnpm --filter @medhub/worker tick",
    "release": "node infra/scripts/release.mjs",
    "keys:generate": "node infra/scripts/generate-keys.mjs",
    "keys:support": "node infra/scripts/generate-support-key.mjs",
    "support:decrypt": "node infra/scripts/decrypt-diagnostic.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "dotenv": "18.0.9"
  }
}
